# Custom feeds appended to OpenWrt feeds.conf.default
# NOTE: keep comment lines ASCII-only; OpenWrt feeds parser rejects non-ASCII/BOM comments
# Sources:
#   kenzok8/openwrt-packages : many luci-app (diskman/fan/timedreboot/advancedplus/partexp/sysctl ...)
#   kenzok8/small             : nikki/mihomo/ddns-go/autocore/my-default-settings/sms-tool/yq ...
#   KuWiNet/ZWRT-Theme        : luci-theme-zwrt (default theme)
#   fildunsky/luci-app-5gmodem: luci-app-5gmodem / luci-i18n-5gmodem-zh-cn (WH3000 Pro only)
src-git kenzo https://github.com/kenzok8/openwrt-packages.git
src-git small https://github.com/kenzok8/small.git
src-git zwrt https://github.com/KuWiNet/ZWRT-Theme.git
src-git 5gmodem https://github.com/fildunsky/luci-app-5gmodem.git
# Optional (uncomment to use):
# src-git nikki https://github.com/nikkinikki-org/OpenWrt-nikki.git
# src-git mihomo https://github.com/morytyann/OpenWrt-mihomo.git
# src-git quectel https://github.com/Orginal-team/quectel-cm.git

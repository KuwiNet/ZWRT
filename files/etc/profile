# ZWRT: 擦除 BusyBox 交互 shell 自动打印的 "BusyBox ... built-in shell (ash)" 欢迎行。
# 该行在 /etc/profile 读取之前就已由 ash 打印, 无运行时开关 (源头关闭需编译期 FEATURE_SH_EXTRA_QUIET,
# ImageBuilder 不重编译 BusyBox)。区分终端处理:
#  - 本地控制台(tty/console/noVNC): 登录前屏幕已被内核 printk 占满, 用清屏 H+2J 一次清干净, 并 dmesg -n
#    抑制后续模块 printk; linux console 清屏可靠, 不会有 FinalShell 压行问题。
#  - SSH 伪终端(FinalShell 等): 不用 2J/3J 清屏(会把多行 banner 压成一行), 改用 CUP 定位 + EL 整行
#    擦除(2K, 只清字符不改行结构); 范围放宽到 8 行, 覆盖命令回显/起始内容导致的行号偏移(旧版固定
#    擦 4 行会漏行, 残留 "UTC) built-in shell (ash)")。仅 apk 基座需要, opkg 基座不处理。
# 关键: 精简版 busybox 未编译 tty applet (# CONFIG_BUSYBOX_DEFAULT_TTY is not set), 系统里没有 tty 命令,
#   用 case "$(tty ...)" 会使 $(tty) 恒为空、错误落到 SSH 分支, 导致本地控制台 dmesg 永不执行、printk
#   与 banner 交错。改用已启用的 readlink (CONFIG_BUSYBOX_DEFAULT_READLINK=y) 读取 stdin 设备名, 并做
#   反向判断: 只有 devpts 伪终端(SSH/tmux 等, 设备名 /dev/pts/N)走擦除分支; 其余全部视为本地控制台
#   (tty1/ttyS 串口/hvc 虚机控制台/console, 覆盖未列举的设备名), readlink 异常返回空时也兜底走此分支。
case "$(readlink /proc/self/fd/0 2>/dev/null)" in
  /dev/pts/*)
	if [ -x /usr/bin/apk ]; then
		printf '\033[1;1H\033[2K\033[2;1H\033[2K\033[3;1H\033[2K\033[4;1H\033[2K\033[5;1H\033[2K\033[6;1H\033[2K\033[7;1H\033[2K\033[8;1H\033[2K\033[1;1H'
	fi
	;;
  *)
	[ -x /usr/bin/apk ] && printf '\033[H\033[2J'
	dmesg -n 1 2>/dev/null
	;;
esac

unset FAILSAFE
[ -e /tmp/.failsafe ] && export FAILSAFE=1

[ -f /etc/banner ] && cat /etc/banner
[ -n "$FAILSAFE" ] && [ -f /etc/banner.failsafe ] && cat /etc/banner.failsafe

if grep -Fsq '/ overlay ro,' /proc/mounts ; then
cat << EOF

 === WARNING! ======================================
 Your JFFS2-partition seems full and overlayfs is
 mounted as READ-ONLY!
 Please try to remove files from /overlay/upper/...
 and reboot!
 ---------------------------------------------------

EOF
fi

export PATH="/usr/sbin:/usr/bin:/sbin:/bin"
HOME=$(grep -E "^${USER:-root}:" /etc/passwd | cut -d ":" -f 6)
HOME=${HOME:-/root}
export HOME
export PS1='\u@\h:\w\$ '
export ENV=/etc/shinit

case "$TERM" in
	xterm*|rxvt*)
		export PS1='\[\e]0;\u@\h: \w\a\]'"$PS1"
	;;
esac

[ -x /bin/more ] || alias more='less'
[ -x /usr/bin/vim ] && alias vi='vim' || alias vim='vi'

alias l='ls -lF'
alias la='ls -a'
alias ll='ls -alF'
alias ls='ls --color=auto'

[ -z "$KSH_VERSION" -o \! -s /etc/mkshrc ] || . /etc/mkshrc

[ -x /usr/bin/arp -o -x /sbin/arp ] || arp() { cat /proc/net/arp; }
[ -x /usr/bin/ldd ] || ldd() { LD_TRACE_LOADED_OBJECTS=1 $*; }

if [ -z "$FAILSAFE" ] ; then
	for FILE in /etc/profile.d/*.sh ; do
		[ -f "${FILE%.sh}.hush" ] && continue
		[ -f "$FILE" ] && . "$FILE"
	done
	unset FILE
fi
